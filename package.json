{
  "name": "direct-gps",
  "version": "1.0.0",
  "description": "DIRECT GPS — Seguimiento satelital en vivo del transporte público de Corrientes Capital",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cap:sync": "npx cap sync android",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:open": "npx cap open android"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "gps",
    "corrientes",
    "colectivos",
    "transporte",
    "smartmovepro",
    "tiempo-real"
  ],
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3"
  }
}
