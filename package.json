{
  "name": "direct-gps",
  "version": "2.8.0",
  "description": "DIRECT GPS — PWA de seguimiento satelital en vivo del transporte público de Corrientes Capital",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node tests/verify.mjs",
    "sync:drivers": "node scripts/sync-drivers.mjs",
    "check:drivers": "node scripts/sync-drivers.mjs --check",
    "cap:sync": "npx cap sync android",
    "android:apk": "npx cap sync android && (cd android && ./gradlew assembleDebug)"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "gps",
    "pwa",
    "corrientes",
    "colectivos",
    "transporte",
    "smartmovepro",
    "tiempo-real"
  ],
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^7.6.11",
    "@capacitor/core": "^7.6.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.11"
  }
}
